{
	"name": "pi-run-tps",
	"version": "0.2.0",
	"description": "Pi extension that prints one token-weighted tokens-per-second summary per agent run, excluding tool execution time",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi-extension",
		"tps",
		"tokens-per-second",
		"throughput"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/YanzuoLu/pi-run-tps.git"
	},
	"homepage": "https://github.com/YanzuoLu/pi-run-tps#readme",
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest --run",
		"check": "npm run typecheck && npm run test"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.87.1",
		"@types/node": "^22.10.2",
		"typescript": "^5.7.2",
		"vitest": "^2.1.8"
	},
	"engines": {
		"node": ">=20"
	}
}
